rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Plants: owner-scoped
    match /plants/{plantId} {
      // Read (get + list), update, delete — resource exists, so resource.data is safe
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;

      // Create — resource is null; validate via request.resource instead
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;

      // Care logs: verify ownership by checking the parent plant document
      match /careLogs/{logId} {
        allow read, write: if request.auth != null
          && request.auth.uid == get(
               /databases/$(database)/documents/plants/$(plantId)
             ).data.userId;
      }
    }
  }
}
